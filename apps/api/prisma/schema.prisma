generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KeyAlgorithm {
  X25519
  ED25519
}

enum DeviceKeyType {
  IDENTITY_SIGNING
  IDENTITY_DH
  SIGNED_PREKEY
  ONE_TIME_PREKEY
}

enum ConversationType {
  DIRECT
  GROUP
}

enum EncryptedEnvelopeType {
  PREKEY
  SESSION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices       Device[]
  conversations ConversationMember[]
  messages      Message[]            @relation("UserMessages")
  sessions      AuthSession[]

  @@index([createdAt])
}

model Device {
  id         String    @id @default(uuid())
  userId     String
  name       String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  keys              DeviceKey[]
  sentMessages      Message[]         @relation("DeviceSentMessages")
  receivedEnvelopes MessageEnvelope[] @relation("RecipientDeviceEnvelopes")

  @@index([userId])
  @@index([revokedAt])
}

model DeviceKey {
  id         String        @id @default(uuid())
  deviceId   String
  type       DeviceKeyType
  algorithm  KeyAlgorithm
  keyId      Int
  publicKey  String
  signature  String?
  createdAt  DateTime      @default(now())
  expiresAt  DateTime?
  consumedAt DateTime?
  revokedAt  DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, type, keyId])
  @@index([deviceId, type, revokedAt])
  @@index([deviceId, type, consumedAt])
  @@index([expiresAt])
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType @default(DIRECT)
  directKey     String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime?

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
  @@index([createdAt])
}

model ConversationMember {
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String   @id @default(uuid())
  conversationId  String
  senderId        String
  senderDeviceId  String
  clientMessageId String
  createdAt       DateTime @default(now())
  sequence        BigInt   @default(autoincrement())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("UserMessages", fields: [senderId], references: [id], onDelete: Restrict)
  senderDevice Device       @relation("DeviceSentMessages", fields: [senderDeviceId], references: [id], onDelete: Restrict)

  envelopes MessageEnvelope[]

  @@unique([senderDeviceId, clientMessageId])
  @@index([conversationId, sequence])
  @@index([senderId, createdAt])
}

model MessageEnvelope {
  messageId         String
  recipientDeviceId String
  envelopeType      EncryptedEnvelopeType
  protocolVersion   Int                   @default(1)
  ciphertext        String
  createdAt         DateTime              @default(now())
  deliveredAt       DateTime?

  message         Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientDevice Device  @relation("RecipientDeviceEnvelopes", fields: [recipientDeviceId], references: [id], onDelete: Restrict)

  @@id([messageId, recipientDeviceId])
  @@index([recipientDeviceId, deliveredAt, createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
